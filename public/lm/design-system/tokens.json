{
  "name": "CONSULTANT design system",
  "version": "1.0.0",
  "date": "2026-09-23",
  "approved": {
    "layout": "A — Apple direction",
    "corners": "images sharp, cards and buttons rounded",
    "type": "Manrope (display) + Onest (text)"
  },
  "color": {
    "black": "#000000",
    "text": "#0A0A0A",
    "white": "#FFFFFF",
    "gray100": "#F5F5F7",
    "gray300": "#E5E5EA",
    "gray600": "#6E6E73",
    "gray400OnDark": "#A1A1A6",
    "darkSurface": "#1C1C1E",
    "darkBorder": "#262626",
    "darkBorderStrong": "#3A3A3C",
    "accent": "#0095D4",
    "budget": {
      "white": "~58%",
      "black": "~30%",
      "gray": "~9%",
      "accent": "1-5%"
    },
    "accentRule": "Only the primary action (Get help), the logo dots and a live indicator dot. Never tinted, never a background, never text, never links. White label on accent only at >= 20px / 700."
  },
  "font": {
    "display": {
      "family": "Manrope",
      "weights": [
        700,
        800
      ],
      "source": "Google Fonts"
    },
    "text": {
      "family": "Onest",
      "weights": [
        400,
        500,
        600
      ],
      "source": "Google Fonts"
    },
    "brand": {
      "family": "Consultant Display",
      "weights": [
        400,
        700
      ],
      "source": "assets/fonts/",
      "use": "required for micro-elements: tier/level chips in caps, caps labels (eyebrows), big figures, numeric badges; also campaign headlines; never body text, buttons, sentence-case headings",
      "derivedFrom": "Bicubik (logo face)",
      "fallback": "Bicubik (assets/fonts/Bicubik.woff2)"
    }
  },
  "typeScale": {
    "display1": {
      "size": 96,
      "weight": 800,
      "lineHeight": 1.0,
      "tracking": "-0.04em",
      "mobile": 44
    },
    "display2": {
      "size": 56,
      "weight": 700,
      "lineHeight": 1.05,
      "tracking": "-0.03em",
      "mobile": 34
    },
    "display3": {
      "size": 32,
      "weight": 700,
      "lineHeight": 1.1,
      "tracking": "-0.02em"
    },
    "title": {
      "size": 26,
      "weight": 700,
      "lineHeight": 1.15,
      "tracking": "-0.02em"
    },
    "titleSm": {
      "size": 18,
      "weight": 700,
      "lineHeight": 1.2,
      "tracking": "-0.01em"
    },
    "stat": {
      "size": 64,
      "weight": 700,
      "lineHeight": 1.0,
      "tracking": "-0.03em",
      "mobile": 44
    },
    "lead": {
      "size": 24,
      "weight": 400,
      "lineHeight": 1.45,
      "color": "gray600"
    },
    "sub": {
      "size": 21,
      "weight": 400,
      "lineHeight": 1.5,
      "color": "gray600"
    },
    "body": {
      "size": 17,
      "weight": 400,
      "lineHeight": 1.5
    },
    "small": {
      "size": 15,
      "weight": 400,
      "lineHeight": 1.5
    },
    "caption": {
      "size": 13,
      "weight": 400,
      "lineHeight": 1.5,
      "color": "gray600"
    },
    "label": {
      "size": 12,
      "weight": 600,
      "tracking": "0.08em",
      "transform": "uppercase",
      "color": "gray600"
    }
  },
  "radius": {
    "image": 0,
    "tile": 28,
    "card": 24,
    "cardDark": 20,
    "input": 980,
    "inputSoft": 14,
    "button": 980,
    "chip": 980,
    "avatar": "50%"
  },
  "space": {
    "base": 8,
    "scale": [
      8,
      16,
      24,
      32,
      40,
      48,
      64,
      80,
      96,
      120
    ],
    "section": 120,
    "sectionMobile": 64,
    "gridGap": 24,
    "cardGap": 20
  },
  "layout": {
    "container": 1200,
    "columns": 12,
    "gutter": 24,
    "pageMargin": 120,
    "breakpoints": {
      "tablet": 1024,
      "mobile": 768
    }
  },
  "button": {
    "primary": {
      "bg": "accent",
      "label": "white 20px/700",
      "height": 60,
      "padding": "0 36px",
      "radius": "pill",
      "hover": "underline label, colour unchanged",
      "max": "one per screen, repeated down the page"
    },
    "secondary": {
      "bg": "text (white on dark)",
      "label": "17px/600",
      "height": 56,
      "padding": "0 28px"
    },
    "outline": {
      "border": "1px gray300 (darkBorderStrong on dark)",
      "label": "17px/600"
    },
    "small": {
      "height": 40,
      "padding": "0 18px",
      "label": "15px/600"
    }
  },
  "logo": {
    "onLight": "assets/logo/logo-on-light.svg",
    "onDark": "assets/logo/logo-on-dark.svg",
    "icon": "assets/logo/logo-icon.svg",
    "navHeight": 36,
    "footerIcon": 46
  }
}